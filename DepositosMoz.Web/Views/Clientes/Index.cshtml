@model IEnumerable<DepositosMoz.Web.Models.Cliente>

@{
    ViewData["Title"] = "Clientes";
}

<h1>Clientes</h1>

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success">
        @TempData["Mensaje"]
    </div>
}

<p>
    <a asp-action="Crear"
       class="btn btn-primary">
        Registrar cliente
    </a>
</p>

<table class="table table-striped table-bordered">
    <thead>
        <tr>
            <th>Nombre</th>
            <th>Teléfono</th>
            <th>Dirección</th>
            <th>Estado</th>
            <th>Acciones</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var cliente in Model)
        {
            <tr>
                <td>@cliente.Nombre</td>
                <td>@cliente.Telefono</td>
                <td>@cliente.Direccion</td>

                <td>
                    @if (cliente.Activo)
                    {
                        <span class="badge bg-success">
                            Activo
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">
                            Inactivo
                        </span>
                    }
                </td>

                <td>
                    <a asp-action="Editar"
                       asp-route-id="@cliente.Id"
                       class="btn btn-sm btn-warning">
                        Editar
                    </a>

                    @if (cliente.Activo)
                    {
                        <form asp-action="Desactivar"
                              asp-route-id="@cliente.Id"
                              method="post"
                              class="d-inline">

                            @Html.AntiForgeryToken()

                            <button type="submit"
                                    class="btn btn-sm btn-danger"
                                    onclick="return confirm('¿Desea desactivar este cliente?');">
                                Desactivar
                            </button>
                        </form>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
