@using DepositosMoz.Web.Models
@model DepositosMoz.Web.Models.Pedido

@{
    ViewData["Title"] = "Detalle del pedido";

    var cliente = ViewBag.Cliente as Cliente;
    var estado = ViewBag.Estado as string ?? "Desconocido";

    var estados =
        ViewBag.Estados as List<EstadoPedido>
        ?? new List<EstadoPedido>();

    var productos =
        ViewBag.Productos as Dictionary<int, string>
        ?? new Dictionary<int, string>();
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2>Detalle del pedido #@Model.Id</h2>
            <p class="text-muted">
                Información general y productos del pedido.
            </p>
        </div>

        <a asp-controller="Pedidos"
           asp-action="Index"
           class="btn btn-secondary">
            Volver
        </a>

    </div>

    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-success">
            @TempData["Mensaje"]
        </div>
    }

    <div class="card mb-4">

        <div class="card-body">

            <div class="row">

                <div class="col-md-6 mb-3">
                    <strong>Cliente:</strong>
                    <div>
                        @(cliente?.Nombre ?? "Cliente no encontrado")
                    </div>
                </div>

                <div class="col-md-6 mb-3">
                    <strong>Estado:</strong>
                    <div>@estado</div>
                </div>

                <div class="col-md-6 mb-3">
                    <strong>Fecha del pedido:</strong>
                    <div>
                        @Model.FechaPedido.ToString("dd/MM/yyyy HH:mm")
                    </div>
                </div>

                <div class="col-md-6 mb-3">
                    <strong>Fecha de entrega:</strong>
                    <div>
                        @Model.FechaEntrega.ToString("dd/MM/yyyy HH:mm")
                    </div>
                </div>

                <div class="col-12">
                    <strong>Observaciones:</strong>

                    <div>
                        @if (string.IsNullOrWhiteSpace(Model.Observaciones))
                        {
                            <span class="text-muted">
                                Sin observaciones.
                            </span>
                        }
                        else
                        {
                            @Model.Observaciones
                        }
                    </div>
                </div>

            </div>

        </div>
    </div>

    <h4>Productos</h4>

    <div class="table-responsive mb-4">

        <table class="table table-striped align-middle">

            <thead class="table-dark">

                <tr>
                    <th>Producto</th>
                    <th>Cantidad</th>
                    <th>Precio unitario</th>
                    <th>Subtotal</th>
                </tr>

            </thead>

            <tbody>

                @foreach (var detalle in Model.Detalles)
                {
                    var nombreProducto =
                        productos.ContainsKey(detalle.ProductoId)
                        ? productos[detalle.ProductoId]
                        : "Producto no encontrado";

                    <tr>
                        <td>@nombreProducto</td>
                        <td>@detalle.Cantidad</td>
                        <td>@detalle.PrecioUnitario.ToString("C2")</td>
                        <td>@detalle.Subtotal.ToString("C2")</td>
                    </tr>
                }

            </tbody>

            <tfoot>
                <tr>
                    <th colspan="3"
                        class="text-end">
                        Total:
                    </th>

                    <th>
                        @Model.Total.ToString("C2")
                    </th>
                </tr>
            </tfoot>

        </table>

    </div>

    <div class="card">

        <div class="card-body">

            <h5 class="card-title">
                Cambiar estado del pedido
            </h5>

            <form asp-controller="Pedidos"
                  asp-action="CambiarEstado"
                  asp-route-id="@Model.Id"
                  method="post">

                <div class="row align-items-end">

                    <div class="col-md-8">

                        <label class="form-label">
                            Estado
                        </label>

                        <select name="estadoId"
                                class="form-select">

                            @foreach (var item in estados)
                            {
                                if (item.Id == Model.EstadoPedidoId)
                                {
                                    <option value="@item.Id"
                                            selected>
                                        @item.Nombre
                                    </option>
                                }
                                else
                                {
                                    <option value="@item.Id">
                                        @item.Nombre
                                    </option>
                                }
                            }

                        </select>

                    </div>

                    <div class="col-md-4 mt-3 mt-md-0">

                        <button type="submit"
                                class="btn btn-primary">
                            Actualizar estado
                        </button>

                    </div>

                </div>

            </form>

        </div>

    </div>

</div>